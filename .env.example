# =============================================================================
# Follow the Money — local configuration
#
# Copy this file to `.env` and fill in your own keys.
#   cp .env.example .env
#
# NOTHING in this project ships with a key. Every key below is YOURS: you get
# it for free (or, for the LLM, you pay your own provider directly). No key is
# ever sent anywhere except to the API it belongs to. `.env` is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. OpenFEC — campaign finance (candidates, committees, contributions)
#    Free. Sign up: https://api.data.gov/signup/
#    Takes about 60 seconds; the key arrives by email immediately.
# -----------------------------------------------------------------------------
FEC_API_KEY=

# -----------------------------------------------------------------------------
# 2. Congress.gov — bills, sponsors, committees, votes
#    Free. Sign up: https://api.congress.gov/sign-up/
#    Same api.data.gov system; a single api.data.gov key works for both #1 and #2.
# -----------------------------------------------------------------------------
CONGRESS_API_KEY=

# -----------------------------------------------------------------------------
# 3. USASpending.gov — federal contract and grant awards
#    No key required. The API is open. Left here for documentation only.
# -----------------------------------------------------------------------------
# USASPENDING_API_KEY=not-required

# -----------------------------------------------------------------------------
# 4. LLM provider — bring your own key (BYOK)
#    Used ONLY for: (a) plain-English bill summaries, (b) classifying which
#    industries a bill plausibly affects, (c) mapping messy employer strings to
#    industry sectors.
#
#    LLM_PROVIDER: anthropic | openai | none
#      "none"  -> the project runs entirely offline using the built-in
#                 deterministic keyword classifier. Lower quality, zero cost,
#                 zero network calls to any LLM. This is the default.
#
#    You are billed by your provider for your own calls. Results are cached on
#    disk so re-running the pipeline does not re-spend money.
# -----------------------------------------------------------------------------
LLM_PROVIDER=none

# If LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# If LLM_PROVIDER=openai (also works with any OpenAI-compatible endpoint,
# including a local one such as Ollama or LM Studio)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# 5. Pipeline scope — keep these small on your first run
# -----------------------------------------------------------------------------
FTM_CONGRESS=119
FTM_ELECTION_CYCLE=2026
FTM_MAX_BILLS=40
FTM_MAX_MEMBERS=60
