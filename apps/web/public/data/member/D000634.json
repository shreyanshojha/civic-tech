udiciary.","policyArea":"Immigration","subjects":[],"sponsorBioguideId":"C001132","cosponsorCount":45,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/2705","industries":[{"industry":"legal","confidence":0.7,"rationale":"Immigration law firms would see changes in demand for services related to family-based visa petitions and the new nonimmigrant parent visa category."},{"industry":"hospitality","confidence":0.4,"rationale":"Reduced family immigration could affect demand for travel and lodging services related to family visits and relocation."}],"plainSummary":"This bill would sharply reduce the number of family-based immigration visas available each year, lowering the annual cap from 480,000 to 88,000. It would eliminate visa categories for siblings and married children of U.S. citizens, and would remove parents of citizens from the immediate-relative category that currently has no numerical limit. Parents of citizens would instead be eligible for a temporary visa that does not allow them to work or receive public benefits.","classificationMethod":"llm","plain":{"whoItTouches":"People applying to live here, and their families here.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"K000405","score":0.03341706325741149},"overlapCount":41},"meaning":{"percentile":81.63748225272126,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.6522865414661398}},{"billId":"119-hr-29","bioguideId":"D000634","cycle":2026,"score":0.018502225932974615,"matches":[{"industry":"legal","donorAmount":51500,"donorShare":0.036588329395706796,"billConfidence":0.85,"contribution":0.01777147427791473},{"industry":"government","donorAmount":2000,"donorShare":0.0014209059959497787,"billConfidence":0.9,"contribution":0.0007307516550598863}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weight