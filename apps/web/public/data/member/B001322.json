itle":"Providing congressional disapproval under chapter 8 of title 5, United States Code, of the rule submitted by the Environmental Protection Agency relating to \"California State Motor Vehicle and Engine Pollution Control Standards; Advanced Clean Cars II; Waiver of Preemption; Notice of Decision\".","introducedDate":"2025-04-02","latestActionDate":"2025-06-12","latestActionText":"Became Public Law No: 119-16.","policyArea":"Environmental Protection","subjects":["Administrative law and regulatory procedures","Air quality","California","Climate change and greenhouse gases","Congressional oversight","Environmental Protection Agency (EPA)","Federal preemption","Hybrid, electric, and advanced technology vehicles","Motor vehicles"],"sponsorBioguideId":"J000302","cosponsorCount":41,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-joint-resolution/88","industries":[{"industry":"manufacturing","confidence":0.95,"rationale":"Automotive manufacturers face different emission and zero-emission vehicle requirements depending on whether California's waiver stands or is revoked."},{"industry":"energy-fossil","confidence":0.7,"rationale":"Zero-emission vehicle mandates directly affect demand for gasoline and diesel fuel in California's large vehicle market."},{"industry":"energy-renewable","confidence":0.65,"rationale":"Electric vehicle adoption rates influence demand for charging infrastructure and electricity from renewable sources."},{"industry":"utilities-electric","confidence":0.6,"rationale":"The pace of electric vehicle deployment affects electricity demand and grid infrastructure investment needs."}],"plainSummary":"This resolution would cancel a federal waiver that allows California to enforce its Advanced Clean Cars II regulations. Those regulations set stricter standards for vehicle emissions and require automakers to sell more zero-emission vehicles in California. If the resolution passes, California would lose the authority to enforce these stricter rules, reverting to federal emission standards.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who drives. People living near a road, a plant or a port.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"L000566","score":0.035788137691442914},"overlapCount":41},"meaning":{"percentile":18.6306988483988,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.7642505024961935}},{"billId":"119-hr-27","bioguideId":"B001322","cycle":2026,"score":0.002051657888049253,"matches":[{"industry":"legal","donorAmount":5958.98,"donorShare":0.004958173229452362,"billConfidence":0.6,"contribution":0.002051657888049253}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.7642505024961935},"bill":{"id":"119-hr-27","congress":119,"billType":"hr","billNumber":"27","title":"HALT Fentanyl Act","introducedDate":"2025-01-03","latestActionDate":"2025-02-10","latestActionText":"Received in the Senate and Read twice and referred to the Committee on the Judiciary.","policyArea":"Crime and Law Enforcement","subjects":["Administrative law and regulatory procedures","Department of Justice","Drug trafficking and controlled substances","Licensing and registrations","Research administration and funding"],"sponsorBioguideId":"G000568","cosponsorCount":59,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/27","industries":[{"industry":"pharma","confidence":0.85,"rationale":"The bill changes registration and licensing requirements for pharmaceutical researchers working with controlled substances and affects the regulatory classification of fentanyl-related compounds."},{"industry":"legal","confidence":0.6,"rationale":"The bill establishes new criminal penalties and quantity thresholds that will affect defense attorneys and prosecutors handling drug trafficking cases."}],"plainSummary":"This bill would permanently classify all fentanyl-related substances as Schedule I controlled substances, meaning they would be treated as having high abuse potential and no accepted medical use. It sets the same criminal penalties and quantity thresholds for fentanyl-related substances as currently apply to fentanyl analogues. The bill also creates a streamlined registration process for researchers studying Schedule I substances and makes it easier for registered researchers to conduct certain activities without additional permits.","classificationMethod":"llm","plain":{"whoItTouches":"People caught up in the criminal law, and victims of crime.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"H001086","score":0.08496351694573398},"overlapCount":58},"meaning":{"percentile":9.339012462533523,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.7642505024961935}}],"votes":[{"id":"a64a90b759595d68f3a8d502","billId":"119-hr-7008","date":"2026-07-22T16:51:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll280.xml"},{"id":"2afa499bcaceefdcecfa862a","billId":"119-hr-8800","date":"2026-07-22T16:37:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll278.xml"},{"id":"e69a4fe10a0cc4e4d35ffc3d","billId":"119-hr-6955","date":"2026-07-21T22:05:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll271.xml"},{"id":"c68077c5b6dd6fe8eb42bf43","billId":"119-hres-1438","date":"2026-07-21T14:39:00-04:00","question":"Recorded Vote","result":"Passed","position":"Aye","sourceUrl":"https://clerk.house.gov/evs/2026/roll254.xml"},{"id":"3944446cfd7ceaa28fbc0515","billId":"119-hres-1438","date":"2026-07-21T14:11:00-04:0