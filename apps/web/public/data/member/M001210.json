Count":59,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/27","industries":[{"industry":"pharma","confidence":0.85,"rationale":"The bill changes registration and licensing requirements for pharmaceutical researchers working with controlled substances and affects the regulatory classification of fentanyl-related compounds."},{"industry":"legal","confidence":0.6,"rationale":"The bill establishes new criminal penalties and quantity thresholds that will affect defense attorneys and prosecutors handling drug trafficking cases."}],"plainSummary":"This bill would permanently classify all fentanyl-related substances as Schedule I controlled substances, meaning they would be treated as having high abuse potential and no accepted medical use. It sets the same criminal penalties and quantity thresholds for fentanyl-related substances as currently apply to fentanyl analogues. The bill also creates a streamlined registration process for researchers studying Schedule I substances and makes it easier for registered researchers to conduct certain activities without additional permits.","classificationMethod":"llm","plain":{"whoItTouches":"People caught up in the criminal law, and victims of crime.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"H001086","score":0.08496351694573398},"overlapCount":58},"meaning":{"percentile":80.63497077870795,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.6220808049138127}},{"billId":"119-hr-7651","bioguideId":"M001210","cycle":2026,"score":0.00998744243695351,"matches":[{"industry":"legal","donorAmount":17750,"donorShare":0.00998744243695351,"billConfidence":0.55,"contribution":0.00998744243695351}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMe