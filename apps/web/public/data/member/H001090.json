ore = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.794365105274752},"bill":{"id":"119-hr-1810","congress":119,"billType":"hr","billNumber":"1810","title":"Safe Schools Improvement Act","introducedDate":"2025-03-03","latestActionDate":"2025-03-03","latestActionText":"Referred to the House Committee on Education and Workforce.","policyArea":"Education","subjects":["Assault and harassment offenses","Census and government statistics","Child safety and welfare","Congressional oversight","Data collection, sharing, protection","Disability and paralysis","Education programs funding","Elementary and secondary education","Government information and archives","Government studies and investigations","Racial and ethnic relations","Religion"],"sponsorBioguideId":"S001156","cosponsorCount":188,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1810","industries":[{"industry":"education","confidence":0.95,"rationale":"The bill imposes new policy, reporting, and grievance-procedure obligations on local educational agencies and state education systems."}],"plainSummary":"This bill would require states to ensure that local school districts adopt policies prohibiting bullying and harassment of students based on race, color, national origin, disability, religion, sex (including sexual orientation, gender identity, and intersex traits). School districts would need to notify students and parents annually about these policies, establish complaint procedures, and publicly report data on bullying incidents. The Department of Education would evaluate anti-bullying programs every two years, and the National Center for Education Statistics would collect nationwide data on these incidents.","classificationMethod":"llm","