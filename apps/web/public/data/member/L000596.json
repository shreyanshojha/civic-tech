hare of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.8305262227557928},"bill":{"id":"119-hjres-140","congress":119,"billType":"hjres","billNumber":"140","title":"Providing for congressional disapproval under chapter 8 of title 5, United States Code, of the rule submitted by the Bureau of Land Management relating to Public Land Order No. 7917 for Withdrawal of Federal Lands; Cook, Lake, and Saint Louis Counties, MN.","introducedDate":"2026-01-12","latestActionDate":"2026-04-27","latestActionText":"Became Public Law No: 119-85.","policyArea":"Public Lands and Natural Resources","subjects":["Administrative law and regulatory procedures","Alternative and renewable resources","Department of the Interior","Lakes and rivers","Land use and conservation","Marine pollution","Mining","Minnesota"],"sponsorBioguideId":"S001212","cosponsorCount":4,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-joint-resolution/140","industries":[{"industry":"mining","confidence":0.95,"rationale":"The bill would directly reopen over 225,000 acres to mineral exploration and leasing that are currently withdrawn from such activity."},{"industry":"ideological-single-issue","confidence":0.75,"rationale":"The bill affects protections for wilderness areas and watersheds, directly implicating environmental and conservation advocacy organizations."},{"industry":"energy-renewable","confidence":0.7,"rationale":"The bill would reopen the lands to geothermal energy leasing and development alongside mineral leasing."}],"plainSummary":"This resolution would reverse a federal order that withdrew approximately 225,504 acres of national forest land in northeastern Minnesota from mineral and geothermal leasing. The original order, issued in 2023, was intended to protect the Rainy River Watershed and the Boundary Waters Canoe Area Wilderness from potential mining impacts for 20 years. If passed, the resolut