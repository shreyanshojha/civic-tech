otGovUrl":"https://www.congress.gov/bill/119th-congress/house-joint-resolution/20","industries":[{"industry":"manufacturing","confidence":0.95,"rationale":"Manufacturers of gas-fired instantaneous water heaters would be directly affected by the nullification of energy efficiency standards that govern their products."},{"industry":"energy-fossil","confidence":0.7,"rationale":"The natural gas industry has a stake in standards that affect the efficiency and market viability of gas-fired appliances."},{"industry":"utilities-electric","confidence":0.5,"rationale":"Gas utilities that supply fuel for these water heaters would be affected by standards that influence appliance efficiency and gas consumption."},{"industry":"real-estate","confidence":0.4,"rationale":"Homebuilders and property developers install water heaters in new construction and would be affected by changes to appliance standards and costs."}],"plainSummary":"This joint resolution would block a Department of Energy rule that set new energy efficiency standards for gas-fired tankless water heaters. The rule, finalized in December 2024, required these appliances to meet stricter energy conservation requirements. If passed, the resolution would nullify those standards and prevent them from taking effect.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who buys fuel or heats a home.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"W000814","score":0.04207911193018987},"overlapCount":29},"meaning":{"percentile":45.916916758805876,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.7470622371795541}},{"billId":"119-hr-633","bioguideId":"H001100","cycle":2026,"score":0.002588320483357461,"matches":[{"industry":"tech","donorAmount":9000,"donorShare":0.0036781396342448138,"billConfidence":0.95,"contribution":0.002588320483357461}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.7470622371795541},"bill":{"id":"119-hr-633","congress":119,"billType":"hr","billNumber":"633","title":"TAKE IT DOWN Act","introducedDate":"2025-01-22","latestActionDate":"2025-04-28","latestActionText":"Placed on the Union Calendar, Calendar No. 59.","policyArea":"Science, Technology, Communications","subjects":["Child safety and welfare","Crimes against children","Criminal investigation, prosecution, interrogation","Digital media","Fraud offenses and financial crimes","Internet, web applications, social media","Pornography","Sex offenses"],"sponsorBioguideId":"S000168","cosponsorCount":40,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/633","industries":[{"industry":"tech","confidence":0.95,"rationale":"The bill directly imposes new content-moderation obligations and 48-hour removal requirements on platforms that host user-generated content."},{"industry":"media-entertainment","confidence":0.4,"rationale":"Online publishers and digital media platforms may face compliance obligations if they host user-generated intimate content."}],"plainSummary":"This bill would make it a federal crime to publish intimate images or videos of someone online without their consent, including computer-generated deepfakes, when the publication is intended to cause harm or involves a minor. It would require websites and apps that host user-generated content to remove such images within 48 hours of being notified by the person depicted. Violators would face criminal penalties including prison time, fines, and mandatory restitution to victims.","classificationMethod":"llm","plain":{"whoItTouches":"Children, and the adults responsible for them. Anyone who uses the internet.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"O000019","score":0.06258174186191032},"overlapCount":39},"meaning":{"percentile":11.704312114989733,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.7470622371795541}},{"billId":"119-hr-8205","bioguideId":"H001100","cycle":2026,"score":0.0012109101676526133,"matches":[{"industry":"health-providers","donorAmount":10000,"donorShare":0.0040868218158275705,"billConfidence":0.4,"contribution":0.0012109101676526133}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.7470622371795541},"bill":{"id":"119-hr-8205","congress":119,"billType":"hr","billNumber":"8205","title":"Accelerating Access to Critical Therapies for ALS Reauthorization Act of 2026","introducedDate":"2026-04-06","latestActionDate":"2026-07-23","latestActionText":"Received in the Senate. Read twice. Placed on Senate Legislative Calendar under General Orders. Calendar No. 466.","policyArea":"Health","subjects":["Department of Health and Human Services","Drug therapy","Food and Drug Administration (FDA)","Government information and archives","Health programs administration and funding","Internet, web applications, social media","Medical research","National Institutes of Health (NIH)","Neurological disorders","Public-private cooperation","Research administration and funding"],"sponsorBioguideId":"Q000023","cosponsorCount":102,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/8205","industries":[{"industry":"pharma","confidence":0.95,"rationale":"The bill directly funds research grants and regulatory pathways for development of drugs and therapies targeting ALS and neurodegenerative diseases."},{"industry":"health-providers","confidence":0.4,"rationale":"Providers treating ALS patients may see changes in available investigational therapies and clinical trial access, though the bill focuses primarily on research and regulatory processes."}],"plainSummary":"This bill extends funding through fiscal year 2031 for federal programs that support research and development of treatments for ALS (Lou Gehrig's disease) and similar neurodegenerative diseases. It requires the National Institutes of Health to track safety data on experimental drugs and mandates that the Food and Drug Administration publish a five-year plan describing how it will help develop and approve therapies for these rare diseases. The bill also continues a public-private partnership between federal agencies and outside organizations working on neurodegenerative disease treatments.","classificationMethod":"llm","plain":{"whoItTouches":"People with an illness that is still being studied. Anyone who uses the internet.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"B001257","score":0.0756937925283595},"overlapCount":102},"meaning":{"percentile":5.054493760859264,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.7470622371795541}}],"votes":[{"id":"a64a90b759595d68f3a8d502","billId":"119-hr-7008","date":"2026-07-22T16:51:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll280.xml"},{"id":"2afa499bcaceefdcecfa862a","billId":"119-hr-8800","date":"2026-07-22T16:37:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll278.xml"},{"id":"e69a4fe10a0cc4e4d35ffc3d","billId":"119-hr-6955","date":"2026-07-21T22:05:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll271.xml"},{"id":"c68077c5b6dd6fe8eb42bf43","billId":"119-hres-1438","date":"2026-07-21T14:39:00-04:00","question":"Recorded Vote","result":"Passed","position":"Aye","sourceUrl":"https://clerk.house.gov/evs/2026/roll254.xml"},{"id":"3944446cfd7ceaa28fbc0515","billI