ies":[{"industry":"tech","confidence":0.95,"rationale":"The bill directly imposes new content-moderation obligations and 48-hour removal requirements on platforms that host user-generated content."},{"industry":"media-entertainment","confidence":0.4,"rationale":"Online publishers and digital media platforms may face compliance obligations if they host user-generated intimate content."}],"plainSummary":"This bill would make it a federal crime to publish intimate images or videos of someone online without their consent, including computer-generated deepfakes, when the publication is intended to cause harm or involves a minor. It would require websites and apps that host user-generated content to remove such images within 48 hours of being notified by the person depicted. Violators would face criminal penalties including prison time, fines, and mandatory restitution to victims.","classificationMethod":"llm","plain":{"whoItTouches":"Children, and the adults responsible for them. Anyone who uses the internet.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"O000019","score":0.06258174186191032},"overlapCount":39},"meaning":{"percentile":74.14310535460433,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.5264844478546931}},{"billId":"119-hr-29","bioguideId":"B001260","cycle":2026,"score":0.008778062691891032,"matches":[{"industry":"legal","donorAmount":17500,"donorShare":0.018072482012716832,"billConfidence":0.85,"contribution":0.008778062691891032}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.5264844478546931},"bill":{"id":"119-hr-29","congress":119,"billType":"hr","billNumber":"29","title":"Laken Riley Act","introducedDate":"2025-01-03","latestActionDate":"2025-02-10","latestAct