ssificationMethod":"llm","unclassifiedDonorShare":0.6214506936969245},"bill":{"id":"119-hr-8592","congress":119,"billType":"hr","billNumber":"8592","title":"No WAR Act","introducedDate":"2026-04-30","latestActionDate":"2026-04-30","latestActionText":"Referred to the Committee on Rules, and in addition to the Committee on the Budget, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned.","policyArea":"Economics and Public Finance","subjects":[],"sponsorBioguideId":"H001094","cosponsorCount":45,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/8592","industries":[{"industry":"defense","confidence":0.85,"rationale":"The bill directly affects the procedural pathway for authorizing and funding military operations, which would impact defense contractors and military service providers."}],"plainSummary":"This bill would create a new procedural rule in the Senate to block the use of reconciliation—a fast-track budget process that avoids filibusters—for funding military operations against Iran unless Congress has formally declared war or passed a specific authorization. The rule could be overridden only by a 60-vote supermajority. In practice, it would make it harder to fund hostilities with Iran through budget bills that normally require only a simple majority.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who pays tax or gets a federal payment.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"C001069","score":0.11907903189084619},"overlapCount":36},"meaning":{"percentile":7.7238982783130625,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.6214506936969245}},{"billId":"119-hr-2790","bioguideId":"R000599","cycle":2026,"score":0.00034060272069706666,"matches":[{"industry":"retail-consumer","donorAmount":2000,"donorShare":0.0011191232251475047,"billConfidence":0.7,"con