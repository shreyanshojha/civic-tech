score":0.05343360379972294},"overlapCount":35},"meaning":{"percentile":60.86133459536205,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.7648697379629859}},{"billId":"119-hr-7","bioguideId":"C001137","cycle":2026,"score":0.013380384195514992,"matches":[{"industry":"ideological-single-issue","donorAmount":48500,"donorShare":0.031595589792464275,"billConfidence":0.75,"contribution":0.009292820527195376},{"industry":"health-providers","donorAmount":11000,"donorShare":0.007166010056022825,"billConfidence":0.85,"contribution":0.002388670018674275},{"industry":"insurance","donorAmount":7000,"donorShare":0.00456018821746907,"billConfidence":0.95,"contribution":0.0016988936496453398}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.7648697379629859},"bill":{"id":"119-hr-7","congress":119,"billType":"hr","billNumber":"7","title":"No Taxpayer Funding for Abortion and Abortion Insurance Full Disclosure Act of 2025","introducedDate":"2025-01-22","latestActionDate":"2025-01-22","latestActionText":"Referred to the Committee on Energy and Commerce, and in addition to the Committees on the Judiciary, and Ways and Means, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned.","policyArea":"Health","subjects":["Abortion","Appropriations","Assault and harassment offenses","Comprehensive health care","Consumer affairs","Crimes against women","Employee benefits and pensions","Government buildings, facilities, and property","Health care costs and insurance","Health care coverage and access","Health facilities and institutions","Health programs administration and funding"],"sponsorBioguideId":"S000522","cosponsorCount":109,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/7","industries":[{"industry":"insurance","confidence":0.95,"rationale":"The bill directly restricts what health insurance plans may cover and how federal subsidies interact with abortion coverage in qualified health plans."},{"industry":"health-providers","confidence":0.85,"rationale":"The bill prohibits federal health care facilities and federal employees from providing abortion services, affecting facilities that currently receive federal funds."},{"industry":"ideological-single-issue","confidence":0.75,"rationale":"Organizations focused on reproductive health policy and abortion access or restrictions have a direct stake in the regulatory framework this bill establishes."}],"plainSummary":"This bill would make permanent the restrictions on federal funding for abortion services and health insurance coverage that includes abortion. Currently, these restrictions are renewed each year through appropriations bills; the bill would apply them across all federal programs and funds. It would also prohibit qualified health plans offered through insurance marketplaces from covering abortion. The bill includes exceptions for cases of rape, incest, or when the pregnant person's life is in danger.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who buys health insurance. Anyone who pays a medical bill.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"B001260","score":0.061260165720508956},"overlapCount":107},"meaning":{"percentile":58.447704685281586,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.7648697379629859}},{"billId":"119-hjres-25","bioguideId":"C001137","cycle":2026,"score":0.012258929232888524,"matches":[{"industry":"finance-banking","donorAmount":50180.68,"donorShare":0.032690477954369405,"billConfidence":0.6,"contribution":0.012258929232888524}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.7648697379629859},"bill":{"id":"119-hjres-25","congress":119,"billType":"hjres","billNumber":"25","title":"Providing for congressional disapproval under chapter 8 of title 5, United States Code, of the rule submitted by the Internal Revenue Service relating to \"Gross Proceeds Reporting by Brokers That Regularly Provide Services Effectuating Digital Asset Sales\".","introducedDate":"2025-01-21","latestActionDate":"2025-04-10","latestActionText":"Became Public Law No: 119-5.","policyArea":"Taxation","subjects":["Administrative law and regulatory procedures","Congressional oversight","Currency","Digital media","Financial services and investments","Internal Revenue Service (IRS)","Tax administration and collection, taxpayers"],"sponsorBioguideId":"C001126","cosponsorCount":8,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-joint-resolution/25","industries":[{"industry":"crypto","confidence":1,"rationale":"The bill directly nullifies IRS reporting requirements specifically targeting digital asset brokers and decentralized finance platforms."},{"industry":"finance-banking","confidence":0.6,"rationale":"Traditional financial institutions that have entered the digital asset brokerage space would be affected by the removal of these reporting obligations."}],"plainSummary":"This resolution would block a new IRS rule that requires certain brokers to report information about digital asset sales to the tax agency. The rule, issued in December 2024, was designed to improve tax reporting on cryptocurrency and other digital asset transactions. If passed, the resolution would nullify these reporting requirements, particularly those affecting decentralized finance platforms that facilitate crypto transactions without traditional financial intermediaries.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who pays federal tax.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"D000626","score":0.06856063614343008},"overlapCount":9},"meaning":{"percentile":55.27685754850923,"median":0.01073720309570498,"n":6339,"ordinary":[{"kind":"state-industry","text":"Banking & Finance is also the top donor sector for 3 other members from CO. That points to the industry being big in the state, not to anything about this member."}],"unattributedShare":0.7648697379629859}},{"billId":"119-hr-685","bioguideId":"C001137","cycle":2026,"score":0.00338394919312189,"matches":[{"industry":"health-providers","donorAmount":11000,"donorShare":0.007166010056022825,"billConfidence":0.85,"contribution":0.00338394919312189}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.7648697379629859},"bill":{"id":"119-hr-685","congress":119,"billType":"hr","billNumber":"685","title":"SAVE Moms and Babies Act of 2025","introducedDate":"2025-01-23","latestActionDate":"2025-01-23","latestActionText":"Referred to the House Committee on Energy and Commerce.","policyArea":"Health","subjects":["Abortion","Drug safety, medical device, and laboratory regulation","Health information and medical records","Health personnel","Health technology, devices, supplies","Marketing and advertising","Prescription drugs"],"sponsorBioguideId":"L000566","cosponsorCount":62,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/685","industries":[{"industry":"pharma","confidence":0.95,"rationale":"The bill directly prohibits approval of new abortion drugs and imposes significant new regulatory restrictions on already-approved drugs in this category."},{"industry":"health-providers","confidence":0.85,"rationale":"The bill creates new certification requirements for prescribing practitioners and mandates they have surgical intervention capability, changing practice obligations."}],"plainSummary":"This bill would prohibit the FDA from approving any new drugs intended to terminate pregnancy. For drugs already approved for this purpose, it would impose new restrictions: requiring in-person dispensing by a specially certified practitioner, prohibiting use after 70 days of gestation, and mandating that the practitioner be able to provide surgical intervention. The bill would also prevent practitioners from both prescribing and dispensing these medications.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who fills a prescription. Anyone who takes a medicine.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"H001086","score":0.11251216543663692},"overlapCount":62},"meaning":{"percentile":15.286322763842877,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.7648697379629859}}],"votes":[{"id":"a64a90b759595d68f3a8d502","billId":"119-hr-7008","date":"2026-07-22T16:51:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll280.xml"},{"id":"2afa499bcaceefdcecfa862a","billId":"119-hr-8800","date":"2026-07-22T16:37:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll278.xml"},{"id":"e69a4fe10a0cc4e4d35ffc3d","billId":"119-hr-6955","date":"2026-07-21T22:05:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll271.xml"},{"id":"c68077c5b6dd6fe8eb42bf43","billId":"119-hres-1438","date":"2026-07-21T14:39:00-04:00","question":"Recorded Vote","result":"Passed","position":"Aye","sourceUrl":"https://clerk.house.gov/evs/2026/roll254.xml"},{"id":"394444