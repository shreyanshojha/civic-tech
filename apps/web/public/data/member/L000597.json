ock a Department of Energy rule published in October 2024 that updated certification, labeling, and enforcement requirements for energy efficiency standards on consumer appliances like washing machines and dishwashers, as well as commercial equipment such as computer room air conditioners. The rule was intended to align reporting with current energy conservation standards and help the Department classify products correctly. If passed, the resolution would nullify these updated requirements.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who buys things.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"S001228","score":0.007564318267455418},"overlapCount":6},"meaning":{"percentile":21.307850260622335,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.7154780527905246}}],"votes":[{"id":"a64a90b759595d68f3a8d502","billId":"119-hr-7008","date":"2026-07-22T16:51:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll280.xml"},{"id":"2afa499bcaceefdcecfa862a","billId":"119-hr-8800","date":"2026-07-22T16:37:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll278.xml"},{"id":"e69a4fe10a0cc4e4d35ffc3d","billId":"119-hr-6955","date":"2026-07-21T22:05:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll271.xml"},{"id":"c68077c5b6dd6fe8eb42bf43","billId":"119-hres-1438","date":"2026-07-21T14:39:00-04:00","question":"Recorded Vote","result":"Passed","position":"Aye","sourceUrl":"https://clerk.house.gov/evs/2026/roll254.xml"},{"id":"3944446cfd7ceaa28fbc0515","billId":"119-hres-1438","date":"2026-07-21T14:11:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll253.xml"},{"id":"7d8b32832c29b7b8b63de5d9","billId":"119-hr-1118","date":"2026-07-21T14:03:00-04:00","question":"