040083035423,"matches":[{"industry":"health-providers","donorAmount":15000,"donorShare":0.005251851028024455,"billConfidence":0.4,"contribution":0.0015561040083035423}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.7526003778846865},"bill":{"id":"119-hr-8205","congress":119,"billType":"hr","billNumber":"8205","title":"Accelerating Access to Critical Therapies for ALS Reauthorization Act of 2026","introducedDate":"2026-04-06","latestActionDate":"2026-07-23","latestActionText":"Received in the Senate. Read twice. Placed on Senate Legislative Calendar under General Orders. Calendar No. 466.","policyArea":"Health","subjects":["Department of Health and Human Services","Drug therapy","Food and Drug Administration (FDA)","Government information and archives","Health programs administration and funding","Internet, web applications, social media","Medical research","National Institutes of Health (NIH)","Neurological disorders","Public-private cooperation","Research administration and funding"],"sponsorBioguideId":"Q000023","cosponsorCount":102,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/8205","industries":[{"industry":"pharma","confidence":0.95,"rationale":"The bill directly funds research grants and regulatory pathways for development of drugs and therapies targeting ALS and neurodegenerative diseases."},{"industry":"health-providers","confidence":0.4,"rationale":"Providers treating ALS patients may see changes in available investigational therapies and clinical trial access, though the bill focuses primarily on research and regulatory processes."}],"plainSummary":"This bill extends funding through fiscal year 2031 for federal programs that support research and development of treatments for ALS (Lou Gehrig's disease) and similar neurodegenerative diseases. It requires the National Institutes of Health to track safety data on experimental drugs and mandates that the Food and Drug Administration publish a five-year plan describing how it will help develop and approve therapies for these rare diseases. The bill also continues a public-private partnership between federal agencies and outside organizations working on neurodegenerative disease treatments.","classificationMethod":"llm","plain":{"whoItTouches":"People with an illness that is still being studied. Anyone who uses the internet.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"B001257","score":0.0756937925283595},"overlapCount":102},"meaning":{"percentile":6.799179681337749,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.7526003778846865}},{"billId":"119-hr-5880","bioguideId":"K000009","cycle":2026,"score":0.001257261306708885,"matches":[{"industry":"manufacturing","donorAmount":6000,"donorShare":0.002100740411209782,"billConfidence":0.85,"contribution":0.0008116497043310523},{"industry":"retail-consumer","donorAmount":7000,"donorShare":0.0024508638130780794,"billConfidence":0.4,"contribution":0.00044561160237783273}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.7526003778846865},"bill":{"id":"119-hr-5880","congress":119,"billType":"hr","billNumber":"5880","title":"Fight Illicit Pill Presses Act","introducedDate":"2025-10-31","latestActionDate":"2026-07-15","latestActionText":"Forwarded by Subcommittee to Full Committee by Voice Vote.","policyArea":"Crime and Law Enforcement","subjects":["Administrative law and regulatory procedures","Criminal procedure and sentencing","Customs enforcement","Department of Justice","Drug trafficking and controlled substances","Health technology, devices, supplies","Manufacturing","Retail and wholesale trades"],"sponsorBioguideId":"H001096","cosponsorCount":14,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/5880","industries":[{"industry":"pharma","confidence":0.95,"rationale":"The bill directly regulates tableting and encapsulating machines used to manufacture pills, imposing new recordkeeping, serial-number, and compliance obligations on equipment suppliers and pharmaceutical manufacturers."},{"industry":"manufacturing","confidence":0.85,"rationale":"Manufacturers of pill presses, encapsulating machines, and their critical parts face new requirements to affix serial numbers and comply with expanded recordkeeping and reporting rules."},{"industry":"retail-consumer","confidence":0.4,"rationale":"Sellers and distributors of regulated pill-press equipment would be newly subject to recordkeeping and reporting obligations under the Controlled Substances Act."}],"plainSummary":"This bill expands federal regulation of pill-making machines and their parts. It would require anyone who sells or delivers these machines—not just manufacturers and importers—to keep records and report transactions. The bill also mandates permanent serial numbers on the machines and their critical parts (like dies and punches), and makes it a crime to remove those serial numbers or to handle machines whose serial numbers have been tampered with.","classificationMethod":"llm","plain":{"whoItTouches":"People caught up in the criminal law, and victims of crime.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"C001120","score":0.010894327351796946},"overlapCount":14},"meaning":{"percentile":5.316295945732766,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.7526003778846865}}],"votes":[{"id":"a64a90b759595d68f3a8d502","billId":"119-hr-7008","date":"2026-07-22T16:5