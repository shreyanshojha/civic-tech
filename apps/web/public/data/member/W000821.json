onorShare":0.6074388374807544},"bill":{"id":"119-hr-27","congress":119,"billType":"hr","billNumber":"27","title":"HALT Fentanyl Act","introducedDate":"2025-01-03","latestActionDate":"2025-02-10","latestActionText":"Received in the Senate and Read twice and referred to the Committee on the Judiciary.","policyArea":"Crime and Law Enforcement","subjects":["Administrative law and regulatory procedures","Department of Justice","Drug trafficking and controlled substances","Licensing and registrations","Research administration and funding"],"sponsorBioguideId":"G000568","cosponsorCount":59,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/27","industries":[{"industry":"pharma","confidence":0.85,"rationale":"The bill changes registration and licensing requirements for pharmaceutical researchers working with controlled substances and affects the regulatory classification of fentanyl-related compounds."},{"industry":"legal","confidence":0.6,"rationale":"The bill establishes new criminal penalties and quantity thresholds that will affect defense attorneys and prosecutors handling drug trafficking cases."}],"plainSummary":"This bill would permanently classify all fentanyl-related substances as Schedule I controlled substances, meaning they would be treated as having high abuse potential and no accepted medical use. It sets the same criminal penalties and quantity thresholds for fentanyl-related substances as currently apply to fentanyl analogues. The bill also creates a streamlined registration process for researchers studying Schedule I substances and makes it easier for registered researchers to conduct certain activities without additional permits.","classificationMethod":"llm","plain":{"whoItTouches":"People caught up in the criminal law, and victims of crime.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"H001086","score":0.08496351694573398},"overlapCount":58},"meaning":{"percentile":25.72961034863543,"median":0.010