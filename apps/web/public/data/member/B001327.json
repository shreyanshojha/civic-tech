onsorCount":40,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/633","industries":[{"industry":"tech","confidence":0.95,"rationale":"The bill directly imposes new content-moderation obligations and 48-hour removal requirements on platforms that host user-generated content."},{"industry":"media-entertainment","confidence":0.4,"rationale":"Online publishers and digital media platforms may face compliance obligations if they host user-generated intimate content."}],"plainSummary":"This bill would make it a federal crime to publish intimate images or videos of someone online without their consent, including computer-generated deepfakes, when the publication is intended to cause harm or involves a minor. It would require websites and apps that host user-generated content to remove such images within 48 hours of being notified by the person depicted. Violators would face criminal penalties including prison time, fines, and mandatory restitution to victims.","classificationMethod":"llm","plain":{"whoItTouches":"Children, and the adults responsible for them. Anyone who uses the internet.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"O000019","score":0.06258174186191032},"overlapCount":39},"meaning":{"percentile":23.298057178960672,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.7093586824790074}},{"billId":"119-hr-9937","bioguideId":"B001327","cycle":2026,"score":0.00383080351963812,"matches":[{"industry":"legal","donorAmount":21000,"donorShare":0.006412431978524679,"billConfidence":0.5,"contribution":0.0029147418084203088},{"industry":"pharma","donorAmount":5500,"donorShare":0.0016794464705659875,"billConfidence":0.6,"contribution":0.0009160617112178112}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileC