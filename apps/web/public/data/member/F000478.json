= Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.5556964610378281},"bill":{"id":"119-hr-5880","congress":119,"billType":"hr","billNumber":"5880","title":"Fight Illicit Pill Presses Act","introducedDate":"2025-10-31","latestActionDate":"2026-07-15","latestActionText":"Forwarded by Subcommittee to Full Committee by Voice Vote.","policyArea":"Crime and Law Enforcement","subjects":["Administrative law and regulatory procedures","Criminal procedure and sentencing","Customs enforcement","Department of Justice","Drug trafficking and controlled substances","Health technology, devices, supplies","Manufacturing","Retail and wholesale trades"],"sponsorBioguideId":"H001096","cosponsorCount":14,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/5880","industries":[{"industry":"pharma","confidence":0.95,"rationale":"The bill directly regulates tableting and encapsulating machines used to manufacture pills, imposing new recordkeeping, serial-number, and compliance obligations on equipment suppliers and pharmaceutical manufacturers."},{"industry":"manufacturing","confidence":0.85,"rationale":"Manufacturers of pill presses, encapsulating machines, and their critical parts face new requirements to affix serial numbers and comply with expanded recordkeeping and reporting rules."},{"industry":"retail-consumer","confidence":0.4,"rationale":"Sellers and distributors of regulated pill-press equipment would be newly subject to recordkeeping and reporting obligations under the Controlled Substances Act."}],"plainSummary":"This bill expands federal regulation of pill-making machines and their parts. It would require anyone who sells or delivers these machines—not just manufacturers and importers—to keep records and report transactions. The bill also mandates permanent serial numbers on the machines and their critical parts (like dies and punches), and makes it a crime to remove those serial numbers or to handle machines whose serial numbers have been tampered with.","classificationMethod":"llm","plain":{"whoItTouches":"People caught up in the criminal law, and victims of crime.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"C001120","score":0.010894327351796946},"overlapCount":14},"meaning":{"percentile":42.735447231424516,"median":0.01073720309570498,"n":6339,"ordinary":[],"unattributedShare":0.5556964610378281}}],"votes":[{"id":"a64a90b759595d68f3a8d502","billId":"119-hr-7008","date":"2026-07-22T16:51:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll280.xml"},{"id":"2afa499bcaceefdcecfa862a","billId":"119-hr-8800","date":"2026-07-22T16:37:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll278.xml"},{"id":"e69a4fe10a0cc4e4d35ffc3d","billId":"119-hr-6955","date":"2026-07-21T22:05:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll271.xml"},{"id":"c68077c5b6dd6fe8eb42bf43","billId":"119-hres-1438","date":"2026-07-21T14:39:00-04:00","question":"Recorded Vote","result":"Passed","position":"Aye","sourceUrl":"https://clerk.house.gov/evs/2026/roll254.xml"},{"id":"3944446cfd7ceaa28fbc0515","billId":"119-hres-1438","date":"2026-07-21T14:11:00-04:00","question":"Yea-and-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll253.xml"},{"id":"7d8b32832c29b7b8b63de5d9","billId":"119-hr-1118","date":"2026-07-21T14:03:00-04:00","question":"2/3 Yea-And-Nay","result":"Passed","position":"Yea","sourceUrl":"https://clerk.house.gov/evs/2026/roll252.xml"},{"id":"a1e6877fc617d20fe7bb5ae7","billId":"119-hr-8823","date":"2026-07-20T19:09:00-04:00","ques