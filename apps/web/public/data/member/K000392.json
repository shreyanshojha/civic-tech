onfidence":0.95,"contribution":0.02775370866459218},{"industry":"health-providers","donorAmount":64800,"donorShare":0.0394072852394175,"billConfidence":0.85,"contribution":0.013135761746472501},{"industry":"ideological-single-issue","donorAmount":12500,"donorShare":0.007601713973653067,"billConfidence":0.75,"contribution":0.00223579822754502}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.5559078696591878},"bill":{"id":"119-hr-7","congress":119,"billType":"hr","billNumber":"7","title":"No Taxpayer Funding for Abortion and Abortion Insurance Full Disclosure Act of 2025","introducedDate":"2025-01-22","latestActionDate":"2025-01-22","latestActionText":"Referred to the Committee on Energy and Commerce, and in addition to the Committees on the Judiciary, and Ways and Means, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned.","policyArea":"Health","subjects":["Abortion","Appropriations","Assault and harassment offenses","Comprehensive health care","Consumer affairs","Crimes against women","Employee benefits and pensions","Government buildings, facilities, and property","Health care costs and insurance","Health care coverage and access","Health facilities and institutions","Health programs administration and funding"],"sponsorBioguideId":"S000522","cosponsorCount":109,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/7","industries":[{"industry":"insurance","confidence":0.95,"rationale":"The bill directly restricts what health insurance plans may cover and how federal subsidies interact with abortion coverage in qualified health plans."},{"industry":"health-providers","confidence":0.85,"rationale":"The bill prohibits federal health care facilities and federal employees from providing abortion services, affecting facilities that currently receive federal funds."},{"industry":"ideological-single-issue","confidence":0.75,"rationale":"Organizations focused on reproductive health policy and abortion access or restrictions have a direct stake in the regulatory framework this bill establishes."}],"plainSummary":"This bill would make permanent the restrictions on federal funding for abortion services and health insurance coverage that includes abortion. Currently, these restrictions are renewed each year through appropriations bills; the bill would apply them across all federal programs and funds. It would also prohibit qualified health plans offered through insurance marketplaces from covering abortion. The bill includes exceptions for cases of rape, incest, or when the pregnant person's life is in danger.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who buys health insurance. Anyone who pays a medical bill.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"B001260","score":0.061260165720508956},"overlapCount":107},"meaning":{"percentile":92.68677933975675,"median":0.010636331736930488,"n":6331,"ordinary":[],"unattributedShare":0.5559078696591878}},{"billId":"119-hjres-25","bioguideId":"K000392","cycle":2026,"score":0.03712677104732157,"matches":[{"industry":"finance-banking","donorAmount":162800,"donorShare":0.09900472279285755,"billConfidence":0.6,"contribution":0.03712677104732157}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.5559078696591878},"bill":{"id":"119-hjres-25","congress":119,"billType":"hjres","billNumber":"25","title":"Providing for congressional disapproval under chapter 8 of title 5, United States Code, of the rule submitted by the Internal Revenue Service relating to \"Gross Proceeds Reporting by Brokers That Regularly Provide Services Effectuating Digital Asset Sales\".","introducedDate":"2025-01-21","latestActionDate":"2025-04-10","latestActionText":"Became Public Law No: 119-5.","policyArea":"Taxation","subjects":["Administrative law and regulatory procedures","Congressional oversight","Currency","Digital media","Financial services and investments","Internal Revenue Service (IRS)","Tax administration and collection, taxpayers"],"sponsorBioguideId":"C001126","cosponsorCount":8,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-joint-resolution/25","industries":[{"industry":"crypto","confidence":1,"rationale":"The bill directly nullifies IRS reporting requirements specifically targeting digital asset brokers and decentralized finance platforms."},{"industry":"finance-banking","confidence":0.6,"rationale":"Traditional financial institutions that have entered the digital asset brokerage space would be affected by the removal of these reporting obligations."}],"plainSummary":"This resolution would block a new IRS rule that requires certain brokers to report information about digital asset sales to the tax agency. The rule, issued in December 2024, was designed to improve tax reporting on cryptocurrency and other digital asset transactions. If passed, the resolution would nullify these reporting requirements, particularly those affecting decentralized finance platforms that facilitate crypto transactions without traditional financial intermediaries.","classificationMethod":"llm","plain":{"whoItTouches":"Anyone who pays federal tax.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"D000626","score":0.06856063614343008},"overlapCount":9},"meaning":{"percentile":90.47543831938083,"median":0.010636331736930488,"n":6331,"ordinary":[{"kind":"state-industry","text":"Banking & Finance is also the top donor sector for 2 other members from TN. That points to the industry being big in the state, not to anything about this member."}],"unattributedShare":0.5559078696591878}},{"billId":"119-hr-3108","bioguideId":"K000392","cycle":2026,"score":0.031199495629627753,"matches":[{"industry":"insurance","donorAmount":122500,"donorShare":0.07449679694180006,"billConfidence":0.5,"contribution":0.012626575752847468},{"industry":"health-providers","donorAmount":64800,"donorShare":0.0394072852394175,"billConfidence":0.9,"contribution":0.012022561598466354},{"industry":"pharma","donorAmount":20500,"donorShare":0.01246681091679103,"billConfidence":0.85,"contribution":0.003592131959075381},{"industry":"tech","donorAmount":20500,"donorShare":0.01246681091679103,"billConfidence":0.7,"contribution":0.0029582263192385492}],"method":{"formula":"score = Σ_industries ( donorShare(industry) × billWeight(industry) ), where billWeight = classifierConfidence / Σ classifierConfidence. Range 0–1, read as a weighted share of disclosed itemized money.","donorProfileCycle":2026,"billClassificationMethod":"llm","unclassifiedDonorShare":0.5559078696591878},"bill":{"id":"119-hr-3108","congress":119,"billType":"hr","billNumber":"3108","title":"RPM Access Act","introducedDate":"2025-04-30","latestActionDate":"2026-07-15","latestActionText":"Ordered to be Reported in the Nature of a Substitute by the Yeas and Nays: 39 - 0.","policyArea":"Health","subjects":["Congressional oversight","Health care costs and insurance","Health care coverage and access","Health care quality","Health technology, devices, supplies","Medicare"],"sponsorBioguideId":"K000392","cosponsorCount":9,"committeeNames":[],"congressDotGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/3108","industries":[{"industry":"health-providers","confidence":0.9,"rationale":"Hospitals and physician groups that offer remote monitoring services must meet new real-time availability and data reporting requirements to receive Medicare payment."},{"industry":"pharma","confidence":0.85,"rationale":"Medical device manufacturers that produce remote patient monitoring equipment face new technical and operational requirements for Medicare reimbursement."},{"industry":"tech","confidence":0.7,"rationale":"Software and IT service providers that develop remote monitoring platforms and electronic health record integration systems are affected by the compatibility and data transmission mandates."},{"industry":"insurance","confidence":0.5,"rationale":"Medicare Advantage plans and other insurers may see changes in reimbursement patterns and cost structures for remote monitoring services."}],"plainSummary":"This bill sets new conditions for Medicare to pay for remote patient monitoring services. It requires health care practitioners to be available in real time to respond to problems detected by monitoring devices, mandates that monitoring systems transmit data in formats compatible with electronic health records, and requires reporting to help evaluate cost savings. The bill also establishes a minimum payment level for these services and directs the Centers for Medicare & Medicaid Services to report on costs and savings over four years.","classificationMethod":"llm","plain":{"whoItTouches":"People on Medicare. Anyone who buys health insurance.","confidence":"crs-summary"},"topOverlap":{"bioguideId":"M001205","score":0.04184912371070318},"overlapCount":10},"meaning":{"percentile":87.20581266782499,"median":0.010636331736930488,"n":6331,"ordinary":[{"kind":"sponsor","text":"They wrote this bill. Sponsoring a bill about your own district's industry is the ordinary case, not the odd one."}],"unattributedShare":0.5559078696591878}},{"billId":"119-hr-7651","bioguideId":"K000392","cycle":2026,"score":0.018700216375186547,"matches":[{"industry":"legal","donorAmount":30750,"donorShare":0.018700216375186547,"billConfidence":0.55,"contribution":0.018700216375186547}],"m